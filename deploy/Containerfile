FROM frappe/build:version-16 AS builder

ARG CACHE_BUST=""

USER frappe

# Apply group permissions after app installation and cleanup, before the runtime COPY.
RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=0,required=true \
  python -c 'import hashlib,json,os,sys; actual=hashlib.sha256(json.dumps(json.load(open("/opt/frappe/apps.json")),sort_keys=True,separators=(",",":")).encode()).hexdigest(); sys.exit(0 if actual==os.environ["CACHE_BUST"] else "ERROR: FRAPPE_APPS_JSON does not match this release. Copy its exact value from deploy/environment.example.")' && \
  bench init --apps_path=/opt/frappe/apps.json \
    --frappe-branch=version-16 \
    --frappe-path=https://github.com/frappe/frappe \
    --no-procfile --no-backups --skip-redis-config-generation --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  test -d apps/crm && test -d apps/sentio_marketing && \
  env/bin/python -c "import crm, sentio_marketing; print('Verified CRM and Sentio Marketing in the built image')" && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr && \
  chmod -R g=u /home/frappe/frappe-bench

FROM frappe/base:version-16 AS backend

USER frappe

COPY --from=builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Keep the COPY destination group-writable and move assets to image-layer storage
RUN chmod g=u /home/frappe/frappe-bench && \
  cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
