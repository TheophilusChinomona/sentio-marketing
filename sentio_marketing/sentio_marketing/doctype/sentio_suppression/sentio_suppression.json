{
  "doctype": "DocType",
  "name": "Sentio Suppression",
  "module": "Sentio Marketing",
  "custom": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "email",
    "reason",
    "evidence"
  ],
  "fields": [
    {
      "fieldname": "email",
      "label": "Email",
      "fieldtype": "Data",
      "unique": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "reason",
      "label": "Reason",
      "fieldtype": "Select",
      "options": "Opted out\nBounced\nManual hold",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "evidence",
      "label": "Source evidence",
      "fieldtype": "Long Text",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Sentio Marketing Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Sales User",
      "read": 1,
      "write": 0,
      "report": 1,
      "print": 1
    }
  ],
  "autoname": "hash"
}
